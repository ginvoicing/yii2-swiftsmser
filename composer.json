{
    "name": "ginvoicing/yii2-swiftsmser",
    "description": "The SMS gateway integration for different SMS clients for the Yii framework",
    "keywords": ["yii2", "swiftsmser", "sms", "gateway"],
    "type": "yii2-extension",
    "license": "MIT",
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/ginvoicing/yii2-swiftsmser/issues",
        "source": "https://github.com/ginvoicing/yii2-swiftsmser"
    },
    "authors": [
        {
            "name": "Tarun Jangra",
            "email": "tarun.jangra@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "ext-curl": "*",
        "linslin/yii2-curl": "^1.5.0",
        "yiisoft/yii2": "^2.0.55",
        "myclabs/php-enum": "^1.8.5"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/verify": "^3.4",
        "codeception/module-filesystem": "^3.0",
        "codeception/module-yii2": "^2.0",
        "codeception/module-asserts": "^3.3",
        "phpro/grumphp": "^2.26",
        "yiisoft/yii2-coding-standards": "^3.0",
        "codeception/assert-throws": "^1.6",
        "yidas/yii2-composer-bower-skip": "^2.0"
    },
    "autoload": {
        "psr-4": { "yii\\swiftsmser\\": "src" }
    },
    "scripts": {
        "post-install-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../yiisoft/yii2-coding-standards/)"
        ],
        "post-update-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../yiisoft/yii2-coding-standards/)"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "phpro/grumphp": true
        }
    }
}
